platform :ios, '13.0'

# Táto časť povie Flutteru, aby si sám našiel potrebné pluginy
install_all_flutter_pods = File.join('..', '.flutter-plugins-dependencies')

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Štandardný príkaz pre načítanie Flutter pluginov (kamera, senzory atď.)
  flutter_install_all_ios_pods File.expand_path(File.join('..', '..', '..', 'flutter', 'packages', 'flutter_tools', 'bin', 'podhelper.rb'), __FILE__)
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Poistka, aby každý plugin bežal na iOS 13
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end