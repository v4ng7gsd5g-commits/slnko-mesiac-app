platform :ios, '13.0'

# Skript, ktorý prepojí tvoju appku s Flutterom
install_all_flutter_pods = File.join('..', '.flutter-plugins-dependencies')

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Automaticky pridá všetky pluginy (senzory, kameru, gps)
  flutter_install_all_ios_pods File.expand_path(File.join('..', '..', '..', 'flutter', 'packages', 'flutter_tools', 'bin', 'podhelper.rb'), __FILE__)
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Poistka, aby každá časť appky vedela, že cieľom je iOS 13
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end