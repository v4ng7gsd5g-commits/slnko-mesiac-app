# Základné nastavenie pre Flutter iOS
platform :ios, '13.0'

# Načítanie Flutter skriptov z relatívnej cesty, ktorá funguje všade
import_path = File.expand_path(File.join('..', '..', '..', 'packages', 'flutter_tools', 'bin', 'xcode_backend.sh'), __FILE__)

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Toto automaticky nájde a nainštaluje všetky pluginy (kameru, senzory)
  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # Oprava pre novšie verzie Xcode v cloude
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end