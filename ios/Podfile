platform :ios, '13.0'

# Táto funkcia zabezpečí, že build nezlyhá, ak chýba config
def flutter_install_ios_pods
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  if File.exist?(generated_xcode_build_settings_path)
    load File.join(File.dirname(__FILE__), 'Flutter', 'podhelper.rb')
  end
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Skúsime načítať pomocníka, ak existuje
  flutter_install_ios_pods
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end