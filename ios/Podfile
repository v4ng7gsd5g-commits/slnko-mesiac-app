platform :ios, '13.0'

# Odstránili sme problematické loadovanie a funkcie
target 'Runner' do
  use_frameworks!
  use_modular_headers!
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # Priame vynútenie verzie bez volania externých funkcií
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end