platform :ios, '13.0'

# Dynamické nájdenie cesty k Flutteru
flutter_install_all_ios_pods File.expand_path(File.join('..', '..', '..', 'flutter', 'packages', 'flutter_tools', 'bin', 'podhelper.rb'), __FILE__)
if !File.exist? (File.expand_path(File.join('..', '..', '..', 'flutter', 'packages', 'flutter_tools', 'bin', 'podhelper.rb'), __FILE__))
  # Alternatívna cesta pre cloudové prostredia
  flutter_install_all_ios_pods File.expand_path(File.join(Dir.home, '.flutter-sdk', 'packages', 'flutter_tools', 'bin', 'podhelper.rb'), __FILE__) rescue nil
end

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Inštalácia všetkých balíčkov (kamera, senzory, gps)
  begin
    flutter_install_all_ios_pods File.expand_path(File.join('..', '..', '..', 'flutter', 'packages', 'flutter_tools', 'bin', 'podhelper.rb'), __FILE__)
  rescue
    # Ak zlyhá prvá cesta, Codemagic si cestu k SDK doplní sám
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
    end
  end
end